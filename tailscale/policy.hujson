// Fragment polityki tailnetu dla VPS-a fabryki.
// SCAL go z obecną polityką (admin console → Access controls). Nie nadpisuj całości,
// bo w tailnecie są inne urządzenia (RPi itd.).
//
// Zasada: ludzie (member) wchodzą na fabrykę po SSH, fabryka nie inicjuje NICZEGO.
// Przed zapisaniem usuń domyślny grant "allow all" (src "*", dst "*"),
// inaczej poniższe ograniczenia nic nie dają.
{
	// Musi istnieć przed `tailscale up --advertise-tags=tag:factory`.
	"tagOwners": {
		"tag:factory": ["autogroup:admin"],
	},

	"grants": [
		// Twoje urządzenia widzą się nawzajem (laptop, telefon, RPi).
		{"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},
		// Ty → fabryka: tylko SSH (Herdr działa po SSH).
		{"src": ["autogroup:member"], "dst": ["tag:factory"], "ip": ["tcp:22"]},
		// Brak grantu z src "tag:factory" = fabryka nie łączy się z nikim w tailnecie.
	],

	// Podmień you@example.com na swój login w Tailscale (nie commituj go do publicznego repo).
	"tests": [
		{
			"src":    "you@example.com",
			"accept": ["tag:factory:22"],
			"deny":   ["tag:factory:80", "tag:factory:443"],
		},
		{
			"src":  "tag:factory",
			"deny": ["you@example.com:22", "you@example.com:80", "you@example.com:443"],
		},
	],
}
